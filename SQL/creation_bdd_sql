-- Création table "avis"
CREATE TABLE avis (
    id               INT AUTO_INCREMENT PRIMARY KEY,
    jeu_nom          VARCHAR(100) NOT NULL,
    user_identifiant VARCHAR(100) NOT NULL,
    note             INT          NOT NULL CHECK (note >= 0 AND note <= 5),
    date_avis        TIMESTAMP    NOT NULL DEFAULT CURRENT_TIMESTAMP
);
